# ==================================
# StackPilot Environment Configuration
# ==================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your-strong-root-password-here
MYSQL_DATABASE=stackpilot
MYSQL_USER=stackpilot
MYSQL_PASSWORD=your-strong-database-password-here
MYSQL_PORT=3306

# Backend Configuration
BACKEND_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Frontend Configuration
FRONTEND_PORT=3001
# API URL for frontend to connect to backend
# For local: http://localhost:3000
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# ==================================
# IMPORTANT SECURITY NOTES:
# ==================================
# 1. Change ALL default passwords before deployment
# 2. Use strong, random passwords (minimum 16 characters)
# 3. Never commit this file with real credentials to git
# 4. Keep this file secure with proper permissions (chmod 600)
# 5. Generate JWT_SECRET using: openssl rand -base64 32
